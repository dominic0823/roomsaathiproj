# Try the app with NO Docker/Postgres/Redis (SQLite + in-memory chat/slots + inline emails).
# Set to False (and run `docker compose up -d`) for the full setup / production.
LOCAL_MODE=True
DEMO_MODE=True

SECRET_KEY=change-this-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Local dev DB (ignored if DATABASE_URL is set, e.g. on Railway)
DB_NAME=marketplace_db
DB_USER=marketplace_user
DB_PASSWORD=marketplace_pass
DB_HOST=127.0.0.1
DB_PORT=5432
# DATABASE_URL=postgres://user:pass@host:5432/dbname

REDIS_URL=redis://127.0.0.1:6379/0

RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=rzp_test_your_key_secret

# Set automatically by Railway once you add a custom domain / generate one
RAILWAY_PUBLIC_DOMAIN=

# --- New in v2 ---------------------------------------------------------
# Razorpay dashboard -> Webhooks: URL https://<your-domain>/payments/webhook/ , events payment.captured
RAZORPAY_WEBHOOK_SECRET=
# Minutes an unpaid booking holds a visit slot
PENDING_BOOKING_MINUTES=15

# Real emails. By default emails are only PRINTED in the server terminal.
# To send real ones (e.g. Gmail: turn on 2-step verification, then create an "App password"),
# remove the leading # from these lines and fill them in:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=youraddress@gmail.com
# EMAIL_HOST_PASSWORD=your16characterapppassword
# DEFAULT_FROM_EMAIL=RoomSaathi <youraddress@gmail.com>

# Room photos in production (Railway disks are wiped on deploy). S3 / Cloudflare R2 / Backblaze:
# AWS_STORAGE_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# only for R2/B2 etc.:
# AWS_S3_ENDPOINT_URL=
# AWS_S3_REGION_NAME=

# --- OTP verification ---------------------------------------------------
# False = nobody is blocked by OTP while you test. Default: False in LOCAL_MODE, True otherwise.
REQUIRE_PHONE_VERIFICATION=True
# local = this app generates codes (console / Twilio / Meta below).  twilio_verify = Twilio Verify generates, sends and checks them.
OTP_PROVIDER=local
# TWILIO_VERIFY_SERVICE_SID=
# Users choose WhatsApp or SMS (or email) when they ask for a code.
# "console" prints the code in the server terminal AND on the page while DEBUG=True (local use only).
# options: console | twilio | meta
OTP_WHATSAPP_BACKEND=console
# options: console | twilio
OTP_SMS_BACKEND=console

# Twilio (SMS and/or WhatsApp). WhatsApp sandbox: message "join <word>" to +1 415 523 8886 first.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# approved template SID (production):
# TWILIO_WHATSAPP_CONTENT_SID=

# Meta WhatsApp Cloud API (OTP_WHATSAPP_BACKEND=meta) - needs an approved authentication template
# META_WA_TOKEN=
# META_WA_PHONE_NUMBER_ID=
# META_WA_TEMPLATE_NAME=
# META_WA_TEMPLATE_LANG=en

# --- Room bookings -------------------------------------------------------
RENTAL_REQUEST_HOURS=48
RENTAL_PAYMENT_HOURS=24
RENTAL_REFUND_DAYS_BEFORE_MOVE_IN=3
